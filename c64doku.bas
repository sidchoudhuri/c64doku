6060 T(V)=T(V)+1
6070 NEXT C
6080 FOR I=1 TO 9:IF T(I)<>1 THEN OK=0
6090 NEXT I
6100 NEXT R
6110 FOR C=1 TO 9
6120 FOR I=1 TO 9:T(I)=0:NEXT I
6130 FOR R=1 TO 9
6140 V=G(R,C):IF V=0 THEN OK=0:GOTO 6160
6150 T(V)=T(V)+1
6160 NEXT R
6170 FOR I=1 TO 9:IF T(I)<>1 THEN OK=0
6180 NEXT I
6190 NEXT C
6200 FOR BR=0 TO 2
6210 FOR BC=0 TO 2
6220 FOR I=1 TO 9:T(I)=0:NEXT I
6230 FOR R=BR*3+1 TO BR*3+3
6240 FOR C=BC*3+1 TO BC*3+3
6250 V=G(R,C):IF V=0 THEN OK=0:GOTO 6270
6260 T(V)=T(V)+1
6270 NEXT C
6280 NEXT R
6290 FOR I=1 TO 9:IF T(I)<>1 THEN OK=0
6300 NEXT I
6310 NEXT BC
6320 NEXT BR
6330 IF OK=1 THEN M$="SOLVED!  WELL DONE.   "
6340 IF OK=0 THEN M$="NOT SOLVED YET.       "
