5160 GOSUB 4100
5170 XC=XC+1:IF XC>9 THEN XC=9
5180 GOSUB 4000
5190 RETURN
5200 REM PLACE DIGIT (BLOCKED ON GIVEN CLUES)
5210 IF F(XR,XC)=1 THEN RETURN
5215 GOSUB 8100
5220 G(XR,XC)=VAL(K$)
5230 R=XR:C=XC:GOSUB 5500
5240 POKE AD,48+VAL(K$)
5250 POKE CD,10
5255 GOSUB 8200
5260 RETURN
5300 REM CLEAR DIGIT
5310 IF F(XR,XC)=1 THEN RETURN
5320 G(XR,XC)=0
5330 R=XR:C=XC:GOSUB 5500
5340 POKE AD,46
5350 POKE CD,10
5360 RETURN
5500 REM CALC SCREEN ADDR (AD) + COLOR ADDR (CD) FROM R,C
5510 SC=C0+2*(C-1)
5520 SR=R0+(R-1)+INT((R-1)/3)
5530 AD=SB+SR*40+SC
5540 CD=CB+SR*40+SC
5550 RETURN
6000 REM CHECK SOLUTION - VALIDATE ROWS/COLS/BOXES
6005 M$="CHECKING...           ":MR=R0+12:MC=C0:MK=1:GOSUB 7000
