1476 POKE 54286,0:POKE 54287,140
1478 RETURN
1500 REM GENERATE RANDOM SOLVED GRID (BAND/STACK SHUFFLE METHOD)
1510 NN=3:GOSUB 2000
1511 FOR I=0 TO 2:BO(I)=SH(I+1)-1:NEXT I
1520 FOR B=0 TO 2
1521 NN=3:GOSUB 2000
1522 FOR I=0 TO 2:RS(B,I)=SH(I+1)-1:NEXT I
1523 NEXT B
1530 NN=3:GOSUB 2000
1531 FOR I=0 TO 2:SO(I)=SH(I+1)-1:NEXT I
1540 FOR S=0 TO 2
1541 NN=3:GOSUB 2000
1542 FOR I=0 TO 2:CS(S,I)=SH(I+1)-1:NEXT I
1543 NEXT S
1550 NN=9:GOSUB 2000
1551 FOR I=0 TO 8:DP(I)=SH(I+1):NEXT I
1560 TR=INT(RND(1)*2)
1570 FOR R=0 TO 8
1580 RM=BO(INT(R/3))*3+RS(INT(R/3),R-INT(R/3)*3)
1590 FOR C=0 TO 8
1600 CM=SO(INT(C/3))*3+CS(INT(C/3),C-INT(C/3)*3)
1610 IF TR=1 THEN RX=CM:CX=RM:GOTO 1620
1615 RX=RM:CX=CM
1620 R3=RX-INT(RX/3)*3
1630 IN=3*R3+INT(RX/3)+CX
1640 BS=IN-INT(IN/9)*9
1650 G(R+1,C+1)=DP(BS):F(R+1,C+1)=1
1660 NEXT C
1670 NEXT R
1680 RETURN
1800 REM REMOVE CLUES (ROTATIONALLY SYMMETRIC PAIRS)
1810 NN=40:GOSUB 2000
1820 FOR K=1 TO NP
1830 IDX=SH(K)
1840 R=PR(IDX):C=QC(IDX)
1850 G(R,C)=0:F(R,C)=0
1860 R2=10-R:C2=10-C
1870 G(R2,C2)=0:F(R2,C2)=0
1880 NEXT K
1890 RETURN
1900 REM BUILD SYMMETRIC PAIR LIST (EXCLUDES CENTER CELL)
1910 IDX=0
1920 FOR R=1 TO 9
1930 FOR C=1 TO 9
1940 IF R<5 OR (R=5 AND C<5) THEN IDX=IDX+1:PR(IDX)=R:QC(IDX)=C
1950 NEXT C
1960 NEXT R
1970 RETURN
2000 REM SHUFFLE SH(1..NN) - FISHER-YATES
2010 FOR I=1 TO NN:SH(I)=I:NEXT I
2020 FOR I=NN TO 2 STEP -1
2030 J=INT(RND(1)*I)+1
2040 T=SH(I):SH(I)=SH(J):SH(J)=T
2050 NEXT I
2060 RETURN
3000 REM DRAW FULL GRID
3010 FOR R=1 TO 9
3020 FOR C=1 TO 9
3030 GOSUB 5500
3040 V=G(R,C)
3050 IF V=0 THEN POKE AD,46:POKE CD,12:GOTO 3080
3060 IF F(R,C)=1 THEN POKE CD,1:GOTO 3070
3065 POKE CD,7
3070 POKE AD,48+V
3080 NEXT C
3090 NEXT R
3100 FOR R=1 TO 9
3110 SR=R0+(R-1)+INT((R-1)/3)
3120 POKE SB+SR*40+C0+5,33:POKE CB+SR*40+C0+5,14
3130 POKE SB+SR*40+C0+11,33:POKE CB+SR*40+C0+11,14
3140 NEXT R
3150 FOR I=0 TO 16
3160 CH=45:IF I=5 OR I=11 THEN CH=43
3170 POKE SB+(R0+3)*40+C0+I,CH:POKE CB+(R0+3)*40+C0+I,14
3180 POKE SB+(R0+7)*40+C0+I,CH:POKE CB+(R0+7)*40+C0+I,14
3190 NEXT I
3200 RETURN
4000 REM DRAW CURSOR HIGHLIGHT
4010 R=XR:C=XC:GOSUB 5500
4020 POKE CD,10
4030 RETURN
4100 REM UNDRAW CURSOR (RESTORE PROPER COLOR)
4110 R=XR:C=XC:GOSUB 5500
4120 IF G(R,C)=0 THEN POKE CD,12:RETURN
4130 IF F(R,C)=1 THEN POKE CD,1:RETURN
4135 POKE CD,7
4140 RETURN
5000 REM CURSOR UP
5005 GOSUB 8000
