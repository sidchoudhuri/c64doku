1010 RM=BO%(INT(R/3))*3+RS%(INT(R/3),R-INT(R/3)*3)
1020 FOR C=0 TO 8
1030 CM=SO%(INT(C/3))*3+CS%(INT(C/3),C-INT(C/3)*3)
