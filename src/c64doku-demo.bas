2080 FOR K=1 TO NP
2090 IDX=SH%(K)
2100 R=PR%(IDX):C=QC%(IDX)
2110 G%(R,C)=0:F%(R,C)=0
2120 R2=10-R:C2=10-C
2130 G%(R2,C2)=0:F%(R2,C2)=0
