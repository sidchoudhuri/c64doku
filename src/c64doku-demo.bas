240 IF XR<>HR THEN IF RND(1)<.5 THEN 260
250 GOSUB 280:XC=XC+SGN(HC-XC):GOTO 320
260 GOSUB 280:XR=XR+SGN(HR-XR):GOTO 320
270 REM A STEP: THE CLICK, THE CELL LEFT GETS ITS COLOUR BACK, THE CURSOR MOVES
280 POKE V1,50:POKE V1+1,60:POKE V1+5,2:POKE V1+6,2
290 POKE V1+4,129:POKE V1+4,128:KT=TI+60
300 V=G%(XR,XC):Z=12:IF V THEN Z=7:IF F%(XR,XC) THEN Z=1
310 POKE AD%(XR,XC)+54272,Z:RETURN
320 POKE AD%(XR,XC)+54272,10:POKE 53248,SX%(XC):POKE 53249,SY%(XR)
330 POKE 53287,1:FP=2:FT=TI+8:IF NT%(XR,XC)<>PN THEN GOSUB 1010
340 GOTO 220
350 REM NOTES ON THE CURSOR CELL: N, ITS POSSIBLE NUMBERS UM, THEN N AGAIN
360 D=2*DT%(SP):GOSUB 40:Z=1:GOSUB 3270:R=14:C=31:GOSUB 1230
370 PRINT "{grn}1-9 S{rvon}ET{rvof}";:R=15:GOSUB 1230:PRINT "{grn}0   C{rvon}LEAR{rvof}";
380 R=16:GOSUB 1230:PRINT "{grn}N   D{rvon}ONE{rvof}";
390 FOR J=1 TO 9:IF (UM AND NB%(J))=0 THEN 420
400 D=2*DT%(SP):GOSUB 40:NT%(XR,XC)=NT%(XR,XC)+NB%(J):GOSUB 1060:GOSUB 1010
410 R=XR:C=XC:GOSUB 970:POKE CD,10
420 NEXT J:D=2*DT%(SP):GOSUB 40:GOTO 3240
430 REM DEMO LOOP: DRAW THE BOARD, THEN PLAY IT CELL BY CELL
440 GOSUB 1710:GOSUB 2510:GOSUB 2570:NC=0:W0=TI+6*DT%(SP)
450 IF EM=0 THEN 590
460 REM LR,LC: THE CELL TO FILL; THE PAUSE TO W0 COUNTS THE TIME IT TAKES
470 GOSUB 610:D=W0-TI:IF D>0 THEN GOSUB 40
480 IF NC THEN 520:REM AT MOST ONE CELL OF NOTES BETWEEN NUMBERS
490 IF RND(1)>=.12-.23*(LK>1) THEN 520
500 GOSUB 760:IF UK=0 THEN 520:REM UR,UC: A CELL TO PUT NOTES ON
510 HR=UR:HC=UC:GOSUB 210:GOSUB 350:NC=NC+1:W0=TI+2*DT%(SP):GOTO 450
520 HR=LR:HC=LC:GOSUB 210:NC=0:D=DT%(SP):GOSUB 40
530 V=SL%(XR,XC):K$=MID$(STR$(V),2):GOSUB 1120:B=NB%(V):N=LN:PM%(N)=0
540 RU%(XR)=RU%(XR) OR B:CU%(XC)=CU%(XC) OR B:I=BX%(N):BU%(I)=BU%(I) OR B
550 IF RU%(XR)=511 OR CU%(XC)=511 OR BU%(I)=511 THEN GOSUB 1090
560 I=EP%(N):J=EI%(EM):EI%(I)=J:EP%(J)=I:EM=EM-1:W0=TI+3*DT%(SP):GOSUB 840
570 GOTO 450
580 REM ALL FILLED: C CHECKS, THEN THE NEXT PUZZLE
590 D=3*DT%(SP):GOSUB 40:GOSUB 2700:D=180:GOSUB 40
600 GOSUB 1550:GOTO 440
610 REM LR,LC (CELL LN): THE NEAREST CELL WITH ONE POSSIBLE NUMBER, FROM SQ%;
620 REM IF THERE IS NONE, THE ONE WITH THE FEWEST (LK OF THEM), NEAREST
630 LS=99:LN=-1:LK=1:Q9=0:IF QN=0 THEN 690
640 REM FILLED CELLS LEAVE THE QUEUE AS IT IS READ
650 FOR K=1 TO QN:N=SQ%(K):IF PM%(N)=0 THEN 680
660 Q9=Q9+1:SQ%(Q9)=N:DD=ABS(RO%(N)-XR)+ABS(CO%(N)-XC)
670 IF DD<LS THEN LS=DD:LN=N
680 NEXT K:QN=Q9
690 IF LN<0 THEN GOSUB 710
700 LR=RO%(LN):LC=CO%(LN):RETURN
710 K9=EM:IF K9>20 THEN K9=20:REM 20 OF THE EMPTY CELLS AT MOST
720 LK=10:LS=999:FOR K=1 TO K9:N=EI%(K):KC=PK%(N):IF KC>LK THEN 750
730 DD=ABS(RO%(N)-XR)+ABS(CO%(N)-XC):SC=KC*20+DD
740 IF SC<LS THEN LS=SC:LK=KC:LN=N
750 NEXT K:RETURN
760 REM UR,UC: A NEAR CELL WITH 2 OR 3 POSSIBLE NUMBERS (UM) AND NO NOTES
770 K9=EM:IF K9>15 THEN K9=15:REM LOOK AT 15 OF THE EMPTY CELLS AT MOST
780 US=99:UK=0:FOR K=1 TO K9:N=EI%(K):KC=PK%(N):IF KC<2 OR KC>3 THEN 820
790 IF NT%(RO%(N),CO%(N)) THEN 820
800 DD=ABS(RO%(N)-XR)+ABS(CO%(N)-XC):IF DD>=US THEN 820
810 US=DD:UN=N:UK=KC:IF DD<4 THEN K=K9
820 NEXT K:IF UK=0 THEN RETURN
830 UR=RO%(UN):UC=CO%(UN):UM=PM%(UN):RETURN
840 REM NUMBER B IS PLACED: IT IS NO LONGER POSSIBLE IN ITS ROW, COLUMN, BOX
850 J0=9*XR-9
860 FOR J=J0 TO J0+8:IF PM%(J) AND B THEN GOSUB 920
870 NEXT J
880 FOR J=XC-1 TO 80 STEP 9:IF PM%(J) AND B THEN GOSUB 920
890 NEXT J:T0=27*INT((XR-1)/3)+3*INT((XC-1)/3)
900 FOR I=T0 TO T0+18 STEP 9:FOR J=I TO I+2:IF PM%(J) AND B THEN GOSUB 920
910 NEXT J,I:RETURN
920 PM%(J)=PM%(J)-B:PK%(J)=PK%(J)-1:IF PK%(J)=1 THEN QN=QN+1:SQ%(QN)=J
930 RETURN
940 REM SCREEN ADDR (AD) + COLOR ADDR (CD) OF CELL R,C, FROM THE TABLE
950 AD=AD%(R,C):CD=AD+54272
960 RETURN
970 REM DRAW CELL R,C: GIVEN WHITE, ENTERED YELLOW, EMPTY GREY
980 GOSUB 940:V=G%(R,C):POKE AD,64+V-30*(NT%(R,C)<>0):Z=12
990 IF V THEN Z=7:IF F%(R,C) THEN Z=1
1000 POKE CD,Z:RETURN
1010 REM NOTES PANEL: THE CURSOR CELL'S CANDIDATES AS A 3X3 KEYPAD
1020 REM PN = WHAT THE PANEL SHOWS NOW; ONLY REDRAWN WHEN IT CHANGES
1030 N1=NT%(XR,XC):IF N1=PN THEN RETURN
1040 PN=N1:FOR I=1 TO 9:Z=11:S=46:IF N1 AND NB%(I) THEN Z=7:S=48+I
1050 POKE PA%(I),S:POKE PA%(I)+54272,Z:NEXT I:RETURN
1060 REM PLACE-DIGIT SOUND (PULSE BLIP)
