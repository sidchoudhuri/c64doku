1770 REM GENERATE RANDOM SOLVED GRID (BAND/STACK SHUFFLE METHOD)
1780 NN=3:GOSUB 2240
1790 FOR I=0 TO 2:BO%(I)=SH%(I+1)-1:NEXT I
1800 FOR B=0 TO 2
1810 NN=3:GOSUB 2240
1820 FOR I=0 TO 2:RS%(B,I)=SH%(I+1)-1:NEXT I
1830 NEXT B
1840 NN=3:GOSUB 2240
1850 FOR I=0 TO 2:SO%(I)=SH%(I+1)-1:NEXT I
1860 FOR S=0 TO 2
1870 NN=3:GOSUB 2240
1880 FOR I=0 TO 2:CS%(S,I)=SH%(I+1)-1:NEXT I
1890 NEXT S
1900 NN=9:GOSUB 2240
1910 FOR I=0 TO 8:DP%(I)=SH%(I+1):NEXT I
