3480 REM POSSIBLE NUMBERS; SQ% THE CELLS WITH ONE (QN OF THEM)
3490 EM=0:QN=0:FOR I=1 TO 9:RU%(I)=0:CU%(I)=0:BU%(I)=0:NEXT I
3500 FOR N=0 TO 80:PM%(N)=0:V=G%(RO%(N),CO%(N)):IF V=0 THEN EM=EM+1:EI%(EM)=N
3510 IF V THEN B=NB%(V):I=BX%(N):BU%(I)=BU%(I) OR B
3520 IF V THEN RU%(RO%(N))=RU%(RO%(N)) OR B:CU%(CO%(N))=CU%(CO%(N)) OR B
3530 NEXT N:FOR K=1 TO EM:N=EI%(K):I=BU%(BX%(N)) OR RU%(RO%(N)) OR CU%(CO%(N))
3540 PM%(N)=511 AND NOT I:PK%(N)=PC%(PM%(N)):EP%(N)=K:IF PK%(N)>1 THEN 3560
3550 QN=QN+1:SQ%(QN)=N
3560 NEXT K:RETURN
3570 REM TABLES: BOX OF EACH CELL, BITS SET IN 0-511, STEP TIMES (SPEED 1-5)
3580 FOR N=0 TO 80:R=INT(N/9)+1:C=N-9*R+10:RO%(N)=R:CO%(N)=C
3590 BX%(N)=3*INT((R-1)/3)+INT((C-1)/3)+1:NEXT N
3600 FOR I=1 TO 511:PC%(I)=PC%(INT(I/2))+(I AND 1):NEXT I
3610 FOR I=1 TO 5:READ DT%(I):NEXT I:SP=2:RETURN
3620 DATA 2,4,7,11,16
