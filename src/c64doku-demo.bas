100 IF TI<WT THEN 60
110 RETURN
120 IF K$="+" THEN IF SP>1 THEN SP=SP-1:GOTO 190
130 IF K$="-" THEN IF SP<5 THEN SP=SP+1:GOTO 190
140 IF K$="M" OR K$="E" OR K$="V" THEN 3110
150 IF K$="T" THEN 3080
160 IF K$="I" THEN GOSUB 3370:WT=TI:RETURN
